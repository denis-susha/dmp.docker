# Variables for compose.bitcart.yml on a shared dev server (all coins on their test networks).
# Copy to development.bitcart.env (git-ignored) and adjust the hosts:
#   cp development.bitcart.env.example development.bitcart.env

# --- Hosts --------------------------------------------------------------------------------
# Bitcart runs in "one domain" mode behind the DMP nginx: admin at /admin, API at /api.
BITCART_HOST=dev.bitcart.example.com
BITCART_STORE_HOST=dev.bitcart.example.com
BITCART_ADMIN_HOST=dev.bitcart.example.com/admin
# URL the admin panel (browser) uses to reach the API.
BITCART_ADMIN_API_URL=http://dev.bitcart.example.com/api
BITCART_REVERSEPROXY=nginx
# Optional overrides (defaults shown):
# BITCART_ADMIN_ROOTPATH=/admin
# BITCART_BACKEND_ROOTPATH=/api
# BITCART_STORE_ROOTPATH=/
# BITCART_HTTPS_ENABLED=false
# BITCART_UPDATE_URL=https://api.bitcart.ai/updates/latest

# --- Enabled coins and networks -------------------------------------------------------------
BITCART_CRYPTOS=btc,ltc,trx,bch,xmr,eth,bnb,matic
BTC_NETWORK=testnet
BTC_LIGHTNING=true
BTC_LIGHTNING_GOSSIP=true
BTC_DEBUG=true
LTC_NETWORK=testnet
LTC_LIGHTNING=true
BCH_NETWORK=testnet4
ETH_NETWORK=sepolia
ETH_SERVER=https://ethereum-sepolia-rpc.publicnode.com
BNB_NETWORK=testnet
BNB_SERVER=https://bsc-testnet-rpc.publicnode.com
MATIC_NETWORK=amoy
MATIC_SERVER=https://rpc.ankr.com/polygon_amoy
TRX_NETWORK=nile
TRX_SERVER=https://api.nileex.io
XMR_NETWORK=stagenet
XMR_SERVER=http://stagenet.xmr-tw.org:38081
# Coins without a daemon in compose.bitcart.yml; only passed through to the backend.
SBCH_NETWORK=mainnet
XRG_NETWORK=mainnet
BSTY_NETWORK=mainnet
BSTY_LIGHTNING=false
GRS_NETWORK=mainnet
GRS_LIGHTNING=false

# --- Server management over SSH (Bitcart admin "Server management") --------------------------
# Paths inside the backend/worker containers (the /datadir volume).
BITCART_SSH_KEY_FILE=/datadir/host_id_rsa
BITCART_SSH_AUTHORIZED_KEYS=/datadir/host_authorized_keys
# Host file mounted at BITCART_SSH_AUTHORIZED_KEYS.
BITCART_HOST_SSH_AUTHORIZED_KEYS=/root/.ssh/authorized_keys
