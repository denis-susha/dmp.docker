# Optional runtime configuration for dmp.job.invoiceworker (service job.invoiceworker-dmp).
# Copy to env/job.invoiceworker.env (git-ignored). Keys use the Section__Key form.

ConnectionStrings__DmpConnection=Host=postgres-dmp;Port=5432;Database=dmarketplace;Username=admin;Password=change-me;SSLMode=disable;Pooling=true

# Internal calls to dmp.api.web (basic auth, see BasicAuthorize__* in env/api.web.env).
DMP.API.WEB__Url=http://dmp-api-web:80
DMP.API.WEB__User=invoiceworker
DMP.API.WEB__Password=change-me

BitcartOptions__WebSocketUri=ws://bitcart-backend:8000/ws/invoices

Minio__s3PublicEndpoint=https://s3.example.com
DmpHosts__Client=https://example.com
DmpHosts__Seller=https://seller.example.com
