# Optional runtime configuration for dmp.job.server (service job.server-dmp, Hangfire).
# Copy to env/job.server.env (git-ignored). Keys use the Section__Key form.

ConnectionStrings__DmpConnection=Host=postgres-dmp;Port=5432;Database=dmarketplace;Username=admin;Password=change-me;SSLMode=disable;Pooling=true

# Outgoing e-mail. In development the dev override provides Mailpit at mailhog-dmp:1025.
SmtpSettings__Host=smtp.example.com
SmtpSettings__Port=587
SmtpSettings__UserName=change-me
SmtpSettings__Password=change-me
SmtpSettings__Ssl=true

# System notifications to a Telegram chat.
TelegramSettings__Enabled=false
TelegramSettings__BotToken=
TelegramSettings__SysChatId=
