# Optional runtime configuration for dmp.api.web (service api.web-dmp).
# Copy to env/api.web.env (git-ignored). Every line overrides the matching appsettings key
# (Section__Key); leave a key out to keep the value from appsettings / user secrets.

ConnectionStrings__DmpConnection=Host=postgres-dmp;Port=5432;Database=dmarketplace;Username=admin;Password=change-me;SSLMode=disable;Pooling=true
ConnectionStrings__BillingDbConnection=Host=dmp-db-billing;Port=5432;Database=billing;Username=admin;Password=change-me;SSLMode=disable;Pooling=true

# Access/refresh tokens and registration (e-mail confirmation) tokens; use long random keys.
JwtSettings__SecretKey=change-me-to-a-long-random-string-of-at-least-32-chars
JwtSettings__Issuer=dmp
JwtSettings__Audience=api.auth
JwtSettings__AccessTokenExpirationMinutes=15
JwtSettings__RefreshTokenExpirationDays=15
JwtRegistrationSettings__SecretKey=change-me-to-another-long-random-string-32-chars
JwtRegistrationSettings__Issuer=dmp
JwtRegistrationSettings__Audience=api.reg
JwtRegistrationSettings__TokenExpirationMinutes=60

# Basic-auth credentials the invoice worker uses for internal callbacks (must match
# DMP.API.WEB__User / DMP.API.WEB__Password in env/job.invoiceworker.env).
BasicAuthorize__User=invoiceworker
BasicAuthorize__Password=change-me

BitcartBackend__Url=http://bitcart-backend:8000/

# MinIO: internal endpoint + root keys, public URL for links, and per-role access keys.
Minio__endpoint=dmp-minio:9000
Minio__accessKey=admin
Minio__secretKey=change-me
Minio__s3PublicEndpoint=https://s3.example.com
Minio__SellerSettings__accessKey=seller
Minio__SellerSettings__secretKey=change-me
Minio__ClientSettings__accessKey=client
Minio__ClientSettings__secretKey=change-me

DmpHosts__Client=https://example.com
DmpHosts__Seller=https://seller.example.com
AllowedHosts=api.example.com;dmp-api-web
Cors__AllowedOrigins__0=https://example.com
Cors__AllowedOrigins__1=https://seller.example.com

# Cloudflare Turnstile secret (the value below is Cloudflare's public "always passes" test key).
CfSettings__TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
