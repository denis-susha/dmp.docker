# Variables for compose.bitcart.yml on a local developer machine (all coins on their test networks).
# Copy to loc.bitcart.env (git-ignored) and add the loc.* hosts to your hosts file (see README):
#   cp loc.bitcart.env.example loc.bitcart.env

# --- Hosts --------------------------------------------------------------------------------
# Bitcart runs in "one domain" mode behind the DMP nginx: admin at /admin, API at /api.
BITCART_HOST=loc.bitcart.example.com
BITCART_STORE_HOST=loc.bitcart.example.com
BITCART_ADMIN_HOST=loc.bitcart.example.com/admin
# URL the admin panel (browser) uses to reach the API.
BITCART_ADMIN_API_URL=http://loc.bitcart.example.com/api
BITCART_REVERSEPROXY=nginx

# --- Enabled coins and networks -------------------------------------------------------------
BITCART_CRYPTOS=btc,ltc,trx,bch,xmr,eth,bnb,matic
BTC_NETWORK=testnet
BTC_LIGHTNING=true
BTC_LIGHTNING_GOSSIP=true
BTC_DEBUG=true
LTC_NETWORK=testnet
LTC_LIGHTNING=true
BCH_NETWORK=testnet4
ETH_NETWORK=sepolia
ETH_SERVER=https://ethereum-sepolia-rpc.publicnode.com
BNB_NETWORK=testnet
BNB_SERVER=https://bsc-testnet-rpc.publicnode.com
MATIC_NETWORK=amoy
MATIC_SERVER=https://api.zan.top/polygon-amoy
TRX_NETWORK=nile
TRX_SERVER=https://api.nileex.io
XMR_NETWORK=stagenet
XMR_SERVER=http://stagenet.xmr-tw.org:38081
SBCH_NETWORK=mainnet
XRG_NETWORK=mainnet
BSTY_NETWORK=mainnet
BSTY_LIGHTNING=false
GRS_NETWORK=mainnet
GRS_LIGHTNING=false

# --- Server management over SSH -------------------------------------------------------------
BITCART_SSH_KEY_FILE=/datadir/host_id_rsa
BITCART_SSH_AUTHORIZED_KEYS=/datadir/host_authorized_keys
BITCART_HOST_SSH_AUTHORIZED_KEYS=/root/.ssh/authorized_keys
