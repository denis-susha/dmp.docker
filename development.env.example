# Variables for compose.yaml + compose.override.dev.yaml.
# Copy to development.env (git-ignored) and replace every change-me value:
#   cp development.env.example development.env

# Optional: pin the Compose project name. It prefixes volume and network names and defaults to
# the directory name, so set it when an existing deployment was started from another directory.
# COMPOSE_PROJECT_NAME=dmpdocker

# Public base domain served by nginx (api., seller., s3., bitcart., ... are derived from it).
# Local/dev hosts use the loc./dev. prefixes, e.g. loc.api.example.com (see README "Hosts file").
DMP_DOMAIN=example.com

# Main marketplace database (service postgres-dmp, container dmp-postgres).
POSTGRES_DMP_USER=admin
POSTGRES_DMP_PASSWORD=change-me
POSTGRES_DMP_DB=dmarketplace

# Billing database (service billing-db-dmp, container dmp-db-billing).
POSTGRES_DMP_BILLING_USER=admin
POSTGRES_DMP_BILLING_PASSWORD=change-me
POSTGRES_DMP_BILLING_DB=billing

# Redis Stack password; also passed to dmp.api.web and dmp.job.server as REDIS_PASSWORD.
REDIS_PASSWORD=change-me

# MinIO root credentials (S3 storage for product files and images).
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# pgAdmin login (dev only, http://localhost:5155).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Optional: UID of the nginx worker user inside the nginx image (default 1000).
# USER_ID=1000

# Optional: path of the dmp.seller checkout used to build the seller SPA (default ../dmp.seller).
# SELLER_DIR=../dmp.seller

# Optional (non-Windows hosts): directory that contains Microsoft/UserSecrets and ASP.NET/Https,
# mounted read-only into the .NET containers. On Windows the real %APPDATA% is used.
# APPDATA=./.appdata

# Storefront (dmp.client) build arguments; baked into the Next.js bundle at image build time.
CLIENT_HOST_URL=https://loc.example.com
CLIENT_API_HOST_URL=https://loc.api.example.com
CLIENT_IMAGES_HOST_URL=https://loc.s3.example.com
CLIENT_SELLER_HOST_URL=https://loc.seller.example.com
# Cloudflare Turnstile site key; the default is Cloudflare's public "always passes" test key.
CLIENT_CF_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional: host name used for SSR when the request Host header should be overridden.
# CLIENT_HOST=
