# Variables for compose.yaml + compose.override.prod.yaml.
# Copy to production.env (git-ignored) and replace every change-me value with a strong secret:
#   cp production.env.example production.env

# Optional: pin the Compose project name (prefix of volume and network names, defaults to the
# directory name). Set it to the old value when moving an existing deployment to a new directory.
# COMPOSE_PROJECT_NAME=dmpdocker

# Public base domain served by nginx (api., seller., s3., bitcart., minioui., jobserver.).
DMP_DOMAIN=example.com

# Main marketplace database (service postgres-dmp, container dmp-postgres).
POSTGRES_DMP_USER=admin
POSTGRES_DMP_PASSWORD=change-me
POSTGRES_DMP_DB=dmarketplace

# Billing database (service billing-db-dmp, container dmp-db-billing).
POSTGRES_DMP_BILLING_USER=admin
POSTGRES_DMP_BILLING_PASSWORD=change-me
POSTGRES_DMP_BILLING_DB=billing

# Redis Stack password; also passed to dmp.api.web and dmp.job.server as REDIS_PASSWORD.
REDIS_PASSWORD=change-me

# MinIO root credentials (S3 storage for product files and images).
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# Optional: UID of the nginx worker user inside the nginx image (default 1000).
# USER_ID=1000

# Optional: path of the dmp.seller checkout used to build the seller SPA (default ../dmp.seller).
# SELLER_DIR=../dmp.seller

# Storefront (dmp.client) build arguments; baked into the Next.js bundle at image build time.
CLIENT_HOST_URL=https://example.com
CLIENT_API_HOST_URL=https://api.example.com
CLIENT_IMAGES_HOST_URL=https://s3.example.com
CLIENT_SELLER_HOST_URL=https://seller.example.com
# Cloudflare Turnstile site key; the default is Cloudflare's public "always passes" test key.
CLIENT_CF_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional: host name used for SSR when the request Host header should be overridden.
# CLIENT_HOST=
