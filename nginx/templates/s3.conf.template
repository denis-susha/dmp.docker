# Public S3 endpoint (MinIO API): s3.${DMP_DOMAIN} and its variants.
upstream s3-proxy {
    server dmp-minio:9000;
}

server {
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    listen [::]:443 ssl;
    include /etc/nginx/include/ssl.conf;

    server_name www.s3.${DMP_DOMAIN};
    return 301 https://s3.${DMP_DOMAIN}$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name s3.${DMP_DOMAIN} ~^(dev\d*|stage.*|loc)\.s3\.${DMP_DOMAIN}$;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    include /etc/nginx/include/ssl.conf;

    server_name s3.${DMP_DOMAIN} ~^(dev\d*|stage.*|loc)\.s3\.${DMP_DOMAIN}$;

    access_log /dev/stdout apm;
    if_modified_since before;
    client_max_body_size 1G;

    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    # Presigned URLs are signed for the internal endpoint, so MinIO must see that host.
    proxy_set_header Host dmp-minio:9000;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    include /etc/nginx/include/robots-disallow.conf;

    location / {
        proxy_pass http://s3-proxy;
    }
}
