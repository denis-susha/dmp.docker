# Bitcart admin panel and API (admin only): bitcart.${DMP_DOMAIN} and its variants.
# Bitcart runs from compose.bitcart.yml and may start after nginx, so its hosts are
# resolved per request through Docker's embedded DNS instead of once at startup.

map $http_x_forwarded_proto $proxy_x_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Pass X-Forwarded-Port through if present, otherwise the port the client connected to.
map $http_x_forwarded_port $proxy_x_forwarded_port {
    default $http_x_forwarded_port;
    ''      $server_port;
}

# Upgrade the connection for WebSockets, otherwise close it.
map $http_upgrade $proxy_connection {
    default upgrade;
    ''      close;
}

map $scheme $proxy_x_forwarded_ssl {
    default off;
    https   on;
}

server_names_hash_bucket_size 128;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    include /etc/nginx/include/ssl.conf;

    server_name bitcart.${DMP_DOMAIN} ~^(dev\d*|stage.*|loc)\.bitcart\.${DMP_DOMAIN}$;

    access_log /dev/stdout apm;
    client_max_body_size 100M;

    include /etc/nginx/include/restrict-access.conf;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $bitcart_admin http://bitcart-admin:4000;
    set $bitcart_backend http://bitcart-backend:8000;

    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_set_header Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $proxy_connection;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
    proxy_set_header X-Forwarded-Ssl $proxy_x_forwarded_ssl;
    proxy_set_header X-Forwarded-Port $proxy_x_forwarded_port;

    location /admin {
        proxy_pass $bitcart_admin;
    }

    # The backend serves its API at the root, so strip the /api prefix.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $bitcart_backend;
    }

    location /ws/ {
        proxy_pass $bitcart_backend;
    }
}
