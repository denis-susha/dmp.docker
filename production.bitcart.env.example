# Variables for compose.bitcart.yml in production (main networks).
# Copy to production.bitcart.env (git-ignored) and adjust hosts, coins and RPC endpoints:
#   cp production.bitcart.env.example production.bitcart.env

BITCART_HOST=bitcart.example.com
BITCART_STORE_HOST=bitcart.example.com
BITCART_ADMIN_HOST=bitcart.example.com/admin
BITCART_ADMIN_API_URL=https://bitcart.example.com/api
BITCART_REVERSEPROXY=nginx

# Comma-separated list of enabled coins: btc, ltc, bch, eth, bnb, matic, trx, xmr.
BITCART_CRYPTOS=btc
BTC_NETWORK=mainnet
BTC_LIGHTNING=false
# Use your own RPC provider endpoints for EVM/Tron/Monero coins in production, e.g.:
# ETH_SERVER=https://mainnet.infura.io/v3/<project-id>
# BNB_SERVER=https://rpc.ankr.com/bsc
# MATIC_SERVER=https://polygon-mainnet.infura.io/v3/<project-id>
# TRX_SERVER=https://rpc.ankr.com/http/tron
# XMR_SERVER=https://node.example.org

BITCART_SSH_KEY_FILE=/datadir/host_id_rsa
BITCART_SSH_AUTHORIZED_KEYS=/datadir/host_authorized_keys
BITCART_HOST_SSH_AUTHORIZED_KEYS=/root/.ssh/authorized_keys
